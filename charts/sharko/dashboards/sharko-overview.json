{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Cluster Status Overview",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(sharko_cluster_count) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Reconciler Run Duration",
      "type": "timeseries",
      "description": "P2-D: sharko_reconciler_duration_seconds is now written by both engines — internal/clusterreconciler's write pass and check pass, and internal/secrets' periodic pass. engine is 'cluster_connection' or 'addon_values' (fixed from the prior 'reconciler' label, which no series ever carried).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(sharko_reconciler_duration_seconds_sum[5m]) / rate(sharko_reconciler_duration_seconds_count[5m])",
          "legendFormat": "{{engine}} avg",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sharko_reconciler_duration_seconds_bucket[5m]))",
          "legendFormat": "{{engine}} p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(sharko_api_requests_total[5m])) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "API Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(sharko_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sharko_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sharko_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Managed Secrets by State",
      "type": "timeseries",
      "description": "P2-D: sharko_managed_secrets_state — how many secrets each engine currently knows about are in each state (in_sync, out_of_sync, missing, foreign, unknown), snapshotted at the end of every completed pass. A rising out_of_sync/missing line with a flat writes rate (see the panel below) is the 'stuck repairing the same thing forever' signal.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sharko_managed_secrets_state",
          "legendFormat": "{{engine}} · {{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Reconciler Writes & Item Failures",
      "type": "timeseries",
      "description": "P2-D D2, the stuck-loop counter: sharko_reconciler_writes_total (a real Kubernetes write) vs. sharko_reconciler_item_failures_total (a check or write that itself could not complete). A flat non-zero writes rate alongside an unchanging Managed Secrets by State panel is the alarm — something keeps reverting what Sharko just wrote.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(sharko_reconciler_writes_total[5m])) by (engine, kind)",
          "legendFormat": "{{engine}} writes · {{kind}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(sharko_reconciler_item_failures_total[5m])) by (engine, reason)",
          "legendFormat": "{{engine}} failures · {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["sharko"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Sharko Overview",
  "uid": "sharko-overview"
}
