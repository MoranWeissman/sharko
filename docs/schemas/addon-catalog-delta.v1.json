{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MoranWeissman/sharko/main/docs/schemas/addon-catalog-delta.v1.json",
  "properties": {
    "apiVersion": {
      "enum": [
        "sharko.dev/v1",
        "sharko.io/v1"
      ]
    },
    "kind": {
      "const": "AddonCatalogDelta"
    },
    "metadata": {
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "spec": {
      "properties": {
        "addons": {
          "additionalProperties": {
            "properties": {
              "repoURL": {
                "type": "string"
              },
              "chart": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "settings": {
                "properties": {
                  "namespace": {
                    "type": "string"
                  },
                  "createNamespace": {
                    "type": "boolean"
                  },
                  "syncOptions": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "ignoreDifferences": {
                    "items": {
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "prune": {
                    "type": "boolean"
                  },
                  "selfHeal": {
                    "type": "boolean"
                  },
                  "preserveResourcesOnDeletion": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "type": "object"
              },
              "additionalSources": {
                "items": {
                  "properties": {
                    "repoURL": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "chart": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "parameters": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "valueFiles": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object"
                },
                "type": "array"
              },
              "extraHelmValues": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "addons"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Sharko AddonCatalogDelta",
  "description": "catalog/addons.yaml — the user's delta against the shipped addon catalog: in-house charts plus overrides of shipped addons (v4)."
}
